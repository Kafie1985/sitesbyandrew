---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
interface Post { id: string | number; title: string; slug: string; mediaUrls?: string[]; dateScheduled?: string | null; markdown?: string; html?: string }
interface ApiResponse { posts?: Post[] }
const formatDate = (value?: string | null) => { if (!value) return ''; const date = new Date(value); return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); };
const buildExcerpt = (post: Post) => { const text=(post.html||post.markdown||'').replace(/<[^>]+>/g,' ').replace(/[#*_>`\\[\\]()-]/g,' ').replace(/\\s+/g,' ').trim(); return text.length>180?`${text.slice(0,177).trimEnd()}…`:text; };
let posts: Post[]=[];
try { const response=await fetch('https://www.sitesbyandrew.me/api/blog/posts',{headers:{Accept:'application/json'}}); if(!response.ok)throw new Error(`Blog request failed: ${response.status}`); const data=await response.json() as ApiResponse; if(!Array.isArray(data.posts))throw new Error('No post list'); posts=data.posts.filter((post)=>post&&typeof post.slug==='string'&&typeof post.title==='string'); } catch(error) { console.warn('[blog] Posts could not be loaded.',error); }
Astro.response.headers.set('Cache-Control','public, s-maxage=300, stale-while-revalidate=1800');
---
<Layout title="Blog | Sites By Andrew" description="Practical guides and ideas for local cleaning businesses, from Sites By Andrew.">
<div class="bg-brand-mist"><section class="mx-auto w-full max-w-[78rem] px-5 pb-20 pt-8 font-brand-body text-brand-navy sm:px-8 sm:pt-14 lg:px-10 lg:pb-28"><div class="max-w-[49rem] border-b border-brand-navy/15 pb-10"><p class="mb-6 text-xs font-bold uppercase tracking-[0.18em] text-brand-teal">The blog</p><h1 class="font-brand-display text-[clamp(2.75rem,7vw,5.5rem)] font-semibold leading-[0.95] tracking-[-0.02em]">Guides and ideas for cleaning companies.</h1><p class="mt-8 max-w-[38rem] text-lg leading-8 text-brand-navy/75 sm:text-xl">Short, practical articles to help your cleaning business win more work and run smoother.</p></div>
{posts.length ? <div class="grid gap-6 pt-10 sm:grid-cols-2 lg:gap-8 lg:pt-14">{posts.map((post)=>{const dateLabel=formatDate(post.dateScheduled);const thumbnail=post.mediaUrls?.[0];return <a class="group flex h-full flex-col overflow-hidden rounded-3xl border border-brand-navy/10 bg-white transition-transform hover:-translate-y-1" href={`/blog/${post.slug}`}>{thumbnail&&<img class="aspect-[16/9] w-full object-cover" src={thumbnail} alt="" loading="lazy" />}<div class="flex flex-1 flex-col p-6 sm:p-8">{dateLabel&&<time class="text-xs font-bold uppercase tracking-[0.14em] text-brand-teal" datetime={post.dateScheduled??undefined}>{dateLabel}</time>}<h2 class="mt-4 font-brand-display text-2xl font-semibold leading-snug tracking-[-0.01em] sm:text-3xl group-hover:text-brand-teal">{post.title}</h2><p class="mt-4 flex-1 leading-7 text-brand-navy/70">{buildExcerpt(post)}</p><span class="mt-6 text-sm font-bold text-brand-teal">Read article <span aria-hidden="true">→</span></span></div></a>;})}</div>:<div class="mt-10 rounded-3xl border border-brand-navy/10 bg-white px-6 py-12 sm:mt-14 sm:px-10 sm:py-16"><p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-teal">Coming soon</p><h2 class="mt-5 max-w-[30rem] font-brand-display text-3xl font-semibold leading-snug tracking-[-0.01em] sm:text-4xl">Posts coming soon.</h2><p class="mt-5 max-w-[34rem] leading-7 text-brand-navy/70">New articles are on the way. In the meantime, you can <a class="font-bold text-brand-teal underline underline-offset-4" href="/contact">start a conversation</a> about your website.</p></div>}</section></div>
</Layout>
