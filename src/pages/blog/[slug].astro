---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
interface Post { id: string | number; title: string; slug: string; mediaUrls?: string[]; dateScheduled?: string | null; html?: string }
const slug=Astro.params.slug??''; let post:Post|null=null;
try { const response=await fetch(`https://www.sitesbyandrew.me/api/blog/posts?slug=${encodeURIComponent(slug)}`,{headers:{Accept:'application/json'}}); if(!response.ok)throw new Error(`Blog request failed: ${response.status}`); const data=await response.json() as {posts?:Post[]}; post=Array.isArray(data.posts)?data.posts.find((item)=>item?.slug===slug)??null:null; } catch(error) { console.warn('[blog] Requested post could not be loaded.',error); }
if(!post) Astro.response.status=404;
const title=post?.title??'Article not found'; const body=post?.html??''; const dateLabel=post?.dateScheduled?new Date(post.dateScheduled).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}):'';
---
<Layout title={`${title} | Sites By Andrew`} description={post?`Read ${title} — practical advice for cleaning companies from Sites By Andrew.`:'This article could not be found.'}><div class="bg-brand-mist">{post?<article class="mx-auto w-full max-w-[78rem] px-5 pb-20 pt-8 font-brand-body text-brand-navy sm:px-8 sm:pt-14 lg:px-10 lg:pb-28"><header class="mx-auto max-w-[48rem] border-b border-brand-navy/15 pb-10"><a class="text-sm font-bold text-brand-teal transition-colors hover:text-brand-navy" href="/blog">← Back to the blog</a><h1 class="mt-8 font-brand-display text-[clamp(2.25rem,6vw,4.25rem)] font-semibold leading-[1.02] tracking-[-0.02em]">{post.title}</h1>{dateLabel&&<time class="mt-6 block text-sm font-bold uppercase tracking-[0.14em] text-brand-navy/60" datetime={post.dateScheduled??undefined}>{dateLabel}</time>}</header>{post.mediaUrls?.[0]&&<img class="mx-auto mt-10 w-full max-w-[48rem] rounded-3xl object-cover" src={post.mediaUrls[0]} alt="" loading="lazy" />}<div class="article-body mx-auto max-w-[44rem] pt-10 text-lg leading-8 text-brand-navy/85 [&_a]:font-bold [&_a]:text-brand-teal [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:my-8 [&_blockquote]:rounded-2xl [&_blockquote]:border-l-4 [&_blockquote]:border-brand-teal [&_blockquote]:bg-white [&_blockquote]:px-6 [&_blockquote]:py-5 [&_blockquote]:font-display [&_blockquote]:text-xl [&_blockquote]:font-semibold [&_blockquote]:leading-snug [&_code]:rounded-md [&_code]:bg-white [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-base [&_h1]:mb-6 [&_h1]:font-brand-display [&_h1]:text-3xl [&_h1]:font-semibold [&_h1]:leading-tight [&_h2]:mb-4 [&_h2]:mt-12 [&_h2]:font-brand-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h3]:mb-3 [&_h3]:mt-10 [&_h3]:font-brand-display [&_h3]:text-xl [&_h4]:mb-3 [&_h4]:mt-8 [&_h4]:font-brand-display [&_h4]:text-lg [&_hr]:my-10 [&_img]:my-8 [&_img]:h-auto [&_img]:max-w-full [&_img]:rounded-2xl [&_li]:my-2 [&_li::marker]:text-brand-teal [&_li::marker]:font-bold [&_ol]:my-6 [&_ol]:list-decimal [&_ol]:pl-7 [&_p]:my-6 [&_pre]:my-8 [&_pre]:overflow-x-auto [&_pre]:rounded-2xl [&_pre]:bg-brand-navy [&_pre]:p-5 [&_pre]:text-brand-mist [&_strong]:font-bold [&_ul]:my-6 [&_ul]:list-disc [&_ul]:pl-7" set:html={body}/></article>:<section class="mx-auto w-full max-w-[78rem] px-5 py-20 font-brand-body text-brand-navy sm:px-8 lg:px-10"><p class="mb-5 text-xs font-bold uppercase tracking-[0.18em] text-brand-teal">Article not found</p><h1 class="font-brand-display text-4xl font-semibold sm:text-5xl">This page isn't here.</h1><a class="mt-8 inline-block font-bold text-brand-teal underline underline-offset-4" href="/blog">Back to all articles</a></section>}</div></Layout>
