---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Sites By Andrew" description="Tell Sites By Andrew what your cleaning business needs from its website, and start with a practical conversation.">
	<section class="mx-auto grid w-full max-w-[78rem] gap-12 px-5 pb-20 pt-8 sm:px-8 sm:pt-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-10 lg:pb-28">
		<div>
			<p class="mb-6 text-xs font-bold uppercase tracking-[0.18em] text-blue">Start a conversation</p>
			<h1 class="font-display text-[clamp(3.25rem,8vw,7rem)] font-semibold leading-[0.9] tracking-[-0.075em]">Let’s make your next step clearer.</h1>
			<p class="mt-8 max-w-[29rem] text-lg leading-8 text-ink-soft">Tell me what is working, what is getting in the way, or what you want customers to understand faster. A short note is plenty.</p>
			<div class="mt-10 grid gap-5 border-t border-line pt-6 text-sm text-ink-soft sm:max-w-[26rem]"><p><span class="font-bold text-ink">Good to know:</span> Sites By Andrew is built for small local businesses, especially cleaning teams who need practical help without a giant agency process.</p><p><span class="font-bold text-ink">What happens next:</span> I’ll read your note, get a feel for the problem, and come back with a useful next step.</p></div>
		</div>
		<div class="rounded-[2rem] bg-paper-deep p-6 sm:p-10">
			<form id="contact-form" class="grid gap-6" action="/api/sendEmail" method="post">
				<div><label class="mb-2 block text-sm font-bold" for="name">Your name</label><input class="w-full rounded-xl border border-line bg-paper px-4 py-3.5 text-ink outline-none transition-shadow placeholder:text-ink-soft/60 focus:ring-2 focus:ring-blue" id="name" name="name" type="text" autocomplete="name" required placeholder="Jane from Bright & Tidy" /></div>
				<div><label class="mb-2 block text-sm font-bold" for="email">Email address</label><input class="w-full rounded-xl border border-line bg-paper px-4 py-3.5 text-ink outline-none transition-shadow placeholder:text-ink-soft/60 focus:ring-2 focus:ring-blue" id="email" name="email" type="email" autocomplete="email" required placeholder="jane@example.com" /></div>
				<div><label class="mb-2 block text-sm font-bold" for="message">What can I help with?</label><textarea class="min-h-40 w-full resize-y rounded-xl border border-line bg-paper px-4 py-3.5 text-ink outline-none transition-shadow placeholder:text-ink-soft/60 focus:ring-2 focus:ring-blue" id="message" name="message" required placeholder="Our website is hard to find and harder to update..."></textarea></div>
				<button class="inline-flex w-fit items-center gap-3 rounded-full bg-blue px-6 py-3.5 font-bold text-paper transition-colors hover:bg-blue-deep disabled:cursor-wait disabled:opacity-60" type="submit">Send note <span aria-hidden="true">↗</span></button><p id="form-status" class="min-h-6 text-sm font-semibold text-ink-soft" aria-live="polite"></p>
			</form>
		</div>
	</section>
	<script is:inline>
		const form = document.querySelector('#contact-form'); const status = document.querySelector('#form-status'); const submit = form?.querySelector('button[type="submit"]');
		form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form || !status || !submit) return; submit.disabled = true; status.textContent = 'Sending your note…'; try { const response = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) }); if (!response.ok) throw new Error('send failed'); form.reset(); status.textContent = 'Thanks — your note is on its way.'; } catch { status.textContent = 'That did not go through. Please try again in a minute.'; } finally { submit.disabled = false; } });
	</script>
</Layout>
