---
interface Props {
  name: string;
  href: string;
  label: string;
}
const { name, href, label } = Astro.props;
---
<a href={href} aria-label={label} class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">
  <span class="sr-only">{label}</span>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><text x="3" y="17" font-size="14">{name.slice(0,1)}</text></svg>
</a>
