---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Sites By Andrew', description = 'Clear, credible websites and small-business solutions for local cleaning companies.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta name="generator" content={Astro.generator} /><meta name="description" content={description} /><title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=Nunito+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline src="/scripts/walterNavigation.js"></script><script is:inline src="/scripts/posthog.js"></script>
</head>
<body class="m-0 min-h-screen bg-paper font-body text-ink antialiased"><div class="min-h-screen overflow-x-hidden">
  <header class="mx-auto flex w-full max-w-[78rem] flex-wrap items-center justify-between gap-5 px-5 py-5 sm:px-8 lg:px-10 lg:py-7"><a href="/" class="font-display text-xl font-bold tracking-[-0.04em] text-ink" aria-label="Sites By Andrew home">Sites By Andrew<span class="text-blue">.</span></a><nav aria-label="Main navigation" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold text-ink-soft sm:gap-x-7"><a class="transition-colors hover:text-blue" href="/">Home</a><a class="transition-colors hover:text-blue" href="/services">Services</a><a class="transition-colors hover:text-blue" href="/contact">Contact</a><a class="rounded-full bg-ink px-4 py-2 text-paper transition-colors hover:bg-blue" href="/blog">Blog</a></nav></header>
  <main><slot /></main><footer class="mx-auto mt-20 flex w-full max-w-[78rem] flex-col gap-6 border-t border-line px-5 py-8 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10"><p>Small business solutions, made useful.</p><a class="w-fit transition-colors hover:text-blue" href="https://marblism.com/?utm_source=website&utm_medium=footer&utm_campaign=designed-by-marblism" target="_blank" rel="noreferrer">Designed by Marblism</a></footer>
</div></body></html>
